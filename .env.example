NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Preferred server-only variables provisioned by the Vercel Supabase integration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_server-only-key
# Legacy fallback for projects that have not migrated to Supabase secret keys.
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Local value. Set this to https://lootriva.com only in the Vercel Production environment.
# Leave Preview unset so the trusted Vercel deployment origin is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com

# Listing media remains on Supabase unless this server-only rollout flag is set to r2.
MEDIA_STORAGE_PROVIDER=supabase
# Required for profile media or when MEDIA_STORAGE_PROVIDER=r2. Never prefix these with NEXT_PUBLIC_.
# R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# R2_BUCKET_NAME=lootriva-images
# R2_ACCESS_KEY_ID=server-only-r2-access-key
# R2_SECRET_ACCESS_KEY=server-only-r2-secret-key

# Profile photos and covers always use the same private R2 bucket, independent
# of MEDIA_STORAGE_PROVIDER. Configure all four R2_* values above for this feature.
